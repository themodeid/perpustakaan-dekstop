              name="LaporanPengembalian" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" uuid="d4e5f6a7-b8c9-0123-defa-123456789034">
    
    <parameter name="TGL_MULAI" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["Semua Periode"]]></defaultValueExpression>
    </parameter>
    <parameter name="TGL_SELESAI" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
    </parameter>
    
    <queryString>
        <![CDATA[SELECT p.id, p.kode_transaksi, a.nim, a.nama AS nama_anggota, u.nama_lengkap AS nama_petugas, 
                        p.tanggal_pinjam, p.tanggal_kembali, p.total_denda, p.catatan 
                 FROM peminjaman p 
                 JOIN anggota a ON p.anggota_id = a.id 
                 JOIN users u ON p.user_id = u.id 
                 WHERE p.status = 'kembali' 
                 ORDER BY p.tanggal_kembali DESC]]>
    </queryString>
    
    <field name="id" class="java.lang.Integer"/>
    <field name="kode_transaksi" class="java.lang.String"/>
    <field name="nim" class="java.lang.String"/>
    <field name="nama_anggota" class="java.lang.String"/>
    <field name="nama_petugas" class="java.lang.String"/>
    <field name="tanggal_pinjam" class="java.sql.Date"/>
    <field name="tanggal_kembali" class="java.sql.Date"/>
    <field name="total_denda" class="java.math.BigDecimal"/>
    <field name="catatan" class="java.lang.String"/>
    
    <variable name="TOTAL_DENDA_SUM" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{total_denda}]]></variableExpression>
    </variable>
    
