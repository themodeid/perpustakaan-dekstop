              name="LaporanBuku" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" uuid="b1f3c87e-908a-4db5-9e6b-123456789abc">
    <property name="ireport.zoom" value="1.0"/>
