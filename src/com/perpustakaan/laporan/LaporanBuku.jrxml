    <queryString>
        <![CDATA[SELECT b.id, b.isbn, b.judul, b.pengarang, b.penerbit, b.tahun_terbit, k.nama_kategori, r.kode_rak, b.stok_total, b.stok_tersedia 
                 FROM buku b 
                 LEFT JOIN kategori k ON b.kategori_id = k.id 
                 LEFT JOIN rak r ON b.rak_id = r.id 
                 WHERE b.is_deleted = 0 
                 ORDER BY b.id ASC]]>
    </queryString>
    
